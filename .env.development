# Loaded automatically when you run `next dev` (NODE_ENV=development).
# Put secrets and overrides in `.env.local` (gitignored). See `.env.local.example`.

NEXT_PUBLIC_SERVER_URL=http://localhost:3002
PAYLOAD_SERVER_URL=http://localhost:3002

# Default local stack: Apollo Router from `romainRetreatServer` Docker federation (:4000).
ROMAIN_RETREAT_SERVER_URL=http://127.0.0.1:4000
ROMAIN_RETREAT_SERVER_GRAPHQL_PATH=/

# Legacy monolith on :3002 — uncomment in `.env.local` if you use that instead:
# ROMAIN_RETREAT_SERVER_URL=http://127.0.0.1:3002
# ROMAIN_RETREAT_SERVER_GRAPHQL_PATH=/graphql

S3_BUCKET=romain-media
S3_REGION=us-east-1
