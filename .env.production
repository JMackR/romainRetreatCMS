# Loaded automatically for `next build` and `next start` (NODE_ENV=production).
# Do not put secrets here if this file is committed — use:
#   - `.env.production.local` (gitignored), or
#   - CodeBuild / ECS task env, or AWS Secrets Manager / SSM.
#
# Replace placeholders with your real public URLs before shipping.

# Public CMS hostname (Route 53 → ALB alias for this app). Adjust subdomain if you use something other than `cms`.
NEXT_PUBLIC_SERVER_URL=https://cms.rrcliving.com
PAYLOAD_SERVER_URL=https://cms.rrcliving.com

# Federated Apollo Router on ECS behind this ALB (no path — router serves GraphQL at `/`).
# Prefer https:// once the ALB listener uses TLS; http:// is fine for same-VPC / private hops.
ROMAIN_RETREAT_SERVER_URL=http://romain-retreat-router-alb-532333725.us-east-1.elb.amazonaws.com
ROMAIN_RETREAT_SERVER_GRAPHQL_PATH=/

S3_BUCKET=romain-media
S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://your-cdn.example.com
# NEXT_PUBLIC_S3_MEDIA_HOSTNAME=your-cdn.example.com

# Never enable DB push against production from the app:
# PAYLOAD_DATABASE_PUSH=0
