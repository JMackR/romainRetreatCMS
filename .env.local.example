# Copy to `.env.local` and fill in (file is gitignored via `.env*.local`):
#   cp .env.local.example .env.local
#
# `.env.local` overrides `.env`, `.env.development`, and `.env.production` for all modes.

# Database (local Postgres / Neon / RDS)
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5432/payload

PAYLOAD_SECRET=YOUR_SECRET_HERE
PREVIEW_SECRET=replace-with-a-long-random-string

# First-time local schema: 1 — steady-state: 0 or remove
PAYLOAD_DATABASE_PUSH=1

# S3 — omit keys on AWS CodeBuild if the role grants bucket access
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_KEY_PREFIX=
